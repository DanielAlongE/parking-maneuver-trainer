# API and replay worker. Defaults match infra/docker-compose.yml.
DATABASE_URL=postgresql://mt:mt@localhost:5432/mt
REDIS_URL=redis://localhost:6379/0
# Base URL of the web app, used in invite links.
PUBLIC_URL=http://localhost:5173
# true when served over HTTPS.
COOKIE_SECURE=false
# Web dev server: where to forward /api.
API_URL=http://localhost:8000
# Replay worker: how often to sweep for submissions that missed the queue.
SWEEP_INTERVAL_MS=15000
