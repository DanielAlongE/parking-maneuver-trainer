{
  "name": "maneuver-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Human-in-the-loop training platform for parking, tight turns and low-speed negotiation",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "golden:generate": "pnpm --filter @mt/sim-core golden:generate",
    "dev:web": "pnpm --filter @mt/web dev",
    "parity:engines": "pnpm --filter @mt/sim-core parity:engines",
    "parity:browsers": "pnpm --filter @mt/web test:parity"
  }
}
